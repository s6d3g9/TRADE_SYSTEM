# Ports exposed on host
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_PORT=8090

# Postgres
POSTGRES_DB=trade_system
POSTGRES_USER=trade
POSTGRES_PASSWORD=trade
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Dev SMTP (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Backend SMTP settings (email confirmations)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=no-reply@trade-system.local

# Optional overrides (usually not needed)
# DATABASE_URL=postgresql+asyncpg://trade:trade@localhost:5432/trade_system
# REDIS_URL=redis://localhost:6379/0
