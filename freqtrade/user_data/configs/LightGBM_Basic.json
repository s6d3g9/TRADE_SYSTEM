{
  "name": "LightGBM Basic Config",
  "description": "Basic LightGBM configuration for price prediction",
  "algorithm": "LightGBMRegressor",
  "tags": ["beginner", "fast-training", "low-memory"],
  "freqai": {
    "enabled": true,
    "model_save_type": "stable",
    "feature_parameters": {
      "include_timeframes": ["5m", "15m", "1h"],
      "include_corr_pairlist": [],
      "label_period_candles": 20,
      "include_shifted_candles": 2,
      "DI_threshold": 0.9,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "indicator_periods_candles": [10, 20, 50]
    },
    "data_split_parameters": {
      "test_size": 0.33,
      "random_state": 1,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 800,
      "learning_rate": 0.1,
      "max_depth": 8,
      "num_leaves": 31,
      "min_child_samples": 20,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "random_state": 42
    }
  }
}
