{
  "name": "XGBoost Advanced Config",
  "description": "Advanced XGBoost configuration with feature engineering",
  "algorithm": "XGBoostRegressor",
  "tags": ["advanced", "high-accuracy", "feature-rich"],
  "freqai": {
    "enabled": true,
    "model_save_type": "stable",
    "feature_parameters": {
      "include_timeframes": ["5m", "15m", "1h", "4h"],
      "include_corr_pairlist": [
        "BTC/USDT",
        "ETH/USDT"
      ],
      "label_period_candles": 24,
      "include_shifted_candles": 3,
      "DI_threshold": 0.95,
      "weight_factor": 0.95,
      "principal_component_analysis": true,
      "use_SVM_to_remove_outliers": true,
      "svm_params": {
        "shuffle": false,
        "nu": 0.1
      },
      "indicator_periods_candles": [10, 20, 50, 100, 200]
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 1000,
      "learning_rate": 0.05,
      "max_depth": 10,
      "min_child_weight": 3,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "gamma": 0.1,
      "reg_alpha": 0.1,
      "reg_lambda": 1.0,
      "random_state": 42
    }
  }
}
